# MCP Webhook STDIO Server Configuration Example
# Copy this file to .env and adjust values as needed

# Server Configuration
# Port for stdio-proxy listener (default: 9000)
PORT=9000

# Human-friendly server name
MCP_NAME=MCP-STDIO-Server

# Authentication
# Comma-separated bearer tokens; leave empty to disable authentication
# Example: WEBHOOK_BEARER_TOKENS=token1,token2,token3
WEBHOOK_BEARER_TOKENS=

# Processing
# Set to "true" to enable asynchronous processing with in-process worker pool
ASYNC_PROCESSING=false

# File Paths
# Path to mapping configuration file (inside container)
MAPPING_FILE=/app/config/mapping.yml

# Logging
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
