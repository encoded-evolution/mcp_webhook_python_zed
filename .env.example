# Port for stdio-proxy TCP listener
PORT=9000

# Human-friendly name for the MCP server
MCP_NAME=MCP-STDIO-Server

# Optional: Comma-separated bearer tokens for authentication
# Leave empty to disable authentication
# Example: WEBHOOK_BEARER_TOKENS=token1,token2,token3
WEBHOOK_BEARER_TOKENS=

# Enable asynchronous processing (true/false)
# When true, events are queued and processed in a background worker pool
ASYNC_PROCESSING=false

# Path to the event mapping configuration file (relative to container)
MAPPING_FILE=/app/config/mapping.yml

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
