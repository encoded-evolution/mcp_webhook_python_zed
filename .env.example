# MCP Webhook Server Configuration Example
# Copy this file to .env and adjust values as needed

# Server Configuration
PORT=9000
MCP_NAME=MCP-STDIO-Server

# Authentication
# Comma-separated bearer tokens; leave empty to disable authentication
WEBHOOK_BEARER_TOKENS=

# Processing Mode
# Set to "true" to enable asynchronous processing
ASYNC_PROCESSING=false

# Redis Configuration
# Redis connection URL for async queue (optional)
# Leave empty to use in-memory queue, or set to: redis://redis:6379/0
# When using docker-compose with --profile async, use: redis://redis:6379/0
REDIS_URL=

# File Paths
MAPPING_FILE=/app/config/mapping.yml

# Logging
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
